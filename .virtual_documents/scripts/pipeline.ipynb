


# Imports 
import os
import sys
import pickle
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.metrics import confusion_matrix, ConfusionMatrixDisplay, accuracy_score
import json
import numpy as np
%matplotlib inline


# Module Imports
# Add the scripts directory to the Python path
sys.path.append(os.path.abspath("../scripts"))

# Import from script files directly (no 'scripts.' prefix)
from load_data import process_star_sample, save_processed_lightcurves
from star_catalog import stars
import importlib


import plot_utils 
import inject_synthetic_flares  
import lstm_flare_classifier
# Use reload in case you are making development changes and need to reload into the Jupyer Lab kernel
importlib.reload(plot_utils)
importlib.reload(inject_synthetic_flares)
importlib.reload(lstm_flare_classifier)

from plot_utils import plot_raw_lightcurves, plot_synthetic_lightcurves, inspect_synthetic_lightcurve
from inject_synthetic_flares import inject_into_lightcurves
from lstm_flare_classifier import train_model, load_model, evaluate_model





# -----------------------
# Parameters
# -----------------------
cadence = "short"          # 2-minute cadence
mission = "TESS"
author = "SPOC"
sector_constraint = None   # Use all sectors

output_raw_path = "../data/processed_lightcurves.pkl"
output_synthetic_path = "../data/synthetic_lightcurves.pkl"





# Run Processing, fetching lightcuves from MAST API
print("Starting light curve processing...")

processed_lightcurves = process_star_sample(
    stars_dict=stars,
    cadence=cadence,
    mission=mission,
    author=author,
    sector_constraint=sector_constraint
)


# Save output as a pickle file to data folder
save_processed_lightcurves(processed_lightcurves, filepath=output_raw_path)
print("Pipeline complete.")


# load in pickle file and plot the raw lightcurves
with open(output_raw_path, 'rb') as f:
    processed_lightcurves = pickle.load(f)

plot_raw_lightcurves(processed_lightcurves, output_dir="../data/figures/raw")
print("Plotting complete.")





# load in pickle file
with open(output_raw_path, 'rb') as f:
    processed_lightcurves = pickle.load(f)


# Generate new synthetic light curves with flare injections
synthetic_lightcurves = inject_into_lightcurves(
    processed_lightcurves,
    num_flares_range=(5, 12),         # Force at least 5 flare per star so we have enough training data for flares 
    inject_in_gaps=True              # Randomly inject in or around gaps
)

# Save to disk as a picjle file to data folder
with open(output_synthetic_path, "wb") as f:
    pickle.dump(synthetic_lightcurves, f)

print("Synthetic flare injection complete")


# Load in synthetic data pickle file from data folder. Plot syntethic lightcuves 
with open(output_synthetic_path, 'rb') as f:
    synthetic_lightcurves = pickle.load(f)
plot_synthetic_lightcurves(synthetic_lightcurves, "../data/figures/synthetic")


# Plot an individual lightcuve if you'd like to inspect the the curve visually 
# Pick any TIC from the dataset
tic = list(synthetic_lightcurves.keys())[0]
inspect_synthetic_lightcurve(tic, synthetic_lightcurves)








# Define Paths for run. This should change every time you run a new model.
run= "E2" # Change this string to test different models/hyperparameters/different processed data 

# Define hyperparameters
learning_rate = 1e-3
batch_size= 64
epochs= 15
seq_len= 100
use_attention= False
hidden_size= 128
num_layers= 3
dropout=0.2
stride= seq_len/2 #50% overlap is common in signal processing

# Define Paths Based on Run
data_path = "../data/synthetic_lightcurves.pkl"  # Input dataset (most likely output_synthetic_path)
split_path = f"../models/splits_{run}.json"         # Path to save train/val/test splits
model_path = f"../models/lstm_flare_classifier_{run}.pt"  # Path to save the trained model
output_dir = f"../outputs/{run}"                    # Directory to save metrics, confusion matrix, etc.


# Train the Model (if not already trained) or load pretrained model from disk
if not os.path.exists(model_path):
    print("Training model from scratch...")
    model = train_model(dataset_path=data_path,
                        split_path= split_path,
                        model_path= model_path, 
                        batch_size=batch_size, 
                        epochs=epochs, 
                        learning_rate=learning_rate,
                        seq_len=seq_len,
                        hidden_size=hidden_size,
                        num_layers=num_layers,
                        dropout=dropout,
                        stride= stride)
else:
    print("Loading pre-trained model...")
    model = load_model(model_path=model_path)



# Evaluate the Model
# loads in-memory model (either after training or loading in pre-trained model)
evaluate_model(model,
               dataset_path=data_path,
               split_path=split_path,
               visualize=True,
               save_report=True,
               output_dir=output_dir,
               batch_size=batch_size,
               seq_len=seq_len,
               stride= stride)




